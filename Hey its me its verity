    }, footer)
    local saveBtn = new("TextButton", {
        Size = UDim2.new(0.27, -4, 0, 28), Position = UDim2.new(0.72, 0, 0.5, -14),
        BackgroundColor3 = ACC, Text = "SAVE", Font = Enum.Font.GothamBold,
        TextSize = 10, TextColor3 = WHITE, BorderSizePixel = 0, AutoButtonColor = false,
    }, footer)
    for _, b in ipairs({resetBtn, saveBtn}) do new("UICorner", {CornerRadius = UDim.new(0, 7)}, b) end
    new("UIGradient", {Rotation = 0, Color = ColorSequence.new(ACC2, ACC)}, saveBtn)
    resetBtn.MouseButton1Click:Connect(function()
        for k, v in pairs(DEFAULTS) do setSetting(k, v) end
        for _, refresh in ipairs(refreshers) do refresh() end
        saveSettings()
        local oldText = resetBtn.Text; resetBtn.Text = "RESET DONE"
        task.delay(0.9, function() if resetBtn.Parent then resetBtn.Text = oldText end end)
    end)
    saveBtn.MouseButton1Click:Connect(function()
        saveSettings(); saveBtn.Text = "SAVED"
        task.delay(0.9, function() if saveBtn.Parent then saveBtn.Text = "SAVE" end end)
    end)

    local gear = new("TextButton", {
        Name = "OpenSettings", Size = UDim2.fromOffset(48, 48), Position = UDim2.new(0, 16, 0.5, -24),
        BackgroundColor3 = BG, Text = "SET", TextSize = 11, TextColor3 = WHITE,
        Font = Enum.Font.GothamBlack, BorderSizePixel = 0, AutoButtonColor = false,
    }, ui)
    new("UICorner", {CornerRadius = UDim.new(0, 13)}, gear)
    new("UIStroke", {Color = ACC, Thickness = 1.5, Transparency = 0.12}, gear)
    new("UIGradient", {Rotation = 35, Color = ColorSequence.new(Color3.fromRGB(45, 25, 36), BG)}, gear)

    local opened = false
    local function toggle()
        opened = not opened
        if opened then
            panel.Visible = true
            panel.Size = UDim2.new(0, 410, 0, 480)
            panel.BackgroundTransparency = 0.08
            panel.Position = UDim2.new(0.5, -205, 0.5, -240)
            tween(panel, 0.24, {Size = UDim2.new(0, 430, 0, 510), Position = UDim2.new(0.5, -215, 0.5, -255), BackgroundTransparency = 0}, Enum.EasingStyle.Back)
        else
            local tw = tween(panel, 0.16, {Size = UDim2.new(0, 410, 0, 480), BackgroundTransparency = 0.12}, Enum.EasingStyle.Quad)
            tw.Completed:Connect(function() if not opened then panel.Visible = false end end)
        end
    end
    gear.MouseButton1Click:Connect(toggle)
    close.MouseButton1Click:Connect(toggle)
    UIS.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == Enum.KeyCode.F6 then toggle() end
    end)

    local dragging, dragStart, startPos = false, nil, nil
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, panel.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    showPage(SCHEMA[1].cat)
end

buildSettingsUI()

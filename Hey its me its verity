function FX.chromAberration(intensity)
    if not (S.ScreenFX and S.ChromAberration) then return end
    intensity = clamp(intensity, 0, 1)
    local alpha = intensity * 0.22
    local shift = intensity * 0.004
    chromR.BackgroundTransparency = 1 - alpha
    chromG.BackgroundTransparency = 1 - alpha * 0.5
    chromB.BackgroundTransparency = 1 - alpha
    chromR.Position = UDim2.fromScale(-shift, -shift * 0.5)
    chromB.Position = UDim2.fromScale(shift, shift * 0.5)
    FX_V11.chromIntensity = intensity
    task.spawn(function()
        local steps = 12
        for i = 1, steps do
            task.wait(0.05)
            local t = 1 - i / steps
            local a2 = t * alpha
            local s2 = t * shift
            chromR.BackgroundTransparency = 1 - a2
            chromG.BackgroundTransparency = 1 - a2 * 0.5
            chromB.BackgroundTransparency = 1 - a2
            chromR.Position = UDim2.fromScale(-s2, -s2 * 0.5)
            chromB.Position = UDim2.fromScale(s2, s2 * 0.5)
        end
        FX_V11.chromIntensity = 0
    end)
end


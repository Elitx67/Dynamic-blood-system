local function registerGroup(group, life)
    table.insert(SplatGroups, group)
    while #SplatGroups > S.MaxSplats do
        local old = table.remove(SplatGroups, 1)
        for _, p in ipairs(old.parts) do p:Destroy() end
    end
    fadeGroupLater(group, life)
end


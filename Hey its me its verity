    local pages, tabButtons, refreshers = {}, {}, {}
    local activePage = nil
    local function tween(obj, duration, props, style)
        local tw = TS:Create(obj, TweenInfo.new(duration, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
        tw:Play()
        return tw
    end
    local function showPage(name)
        activePage = name
        for n, pg in pairs(pages) do
            local selected = n == name
            pg.Visible = selected
            if selected then pg.CanvasPosition = Vector2.zero end
        end
        for n, b in pairs(tabButtons) do
            local selected = n == name
            tween(b, 0.16, {BackgroundColor3 = selected and ACC or ROW})
            b.TextColor3 = selected and WHITE or MUTED
            local stroke = b:FindFirstChildOfClass("UIStroke")
            if stroke then tween(stroke, 0.16, {Transparency = selected and 0.15 or 0.85}) end
        end
    end
    local function makeRow(page, h)
        local row = new("Frame", {
            Size = UDim2.new(1, -4, 0, h), BackgroundColor3 = ROW,
            BorderSizePixel = 0, ClipsDescendants = false,
        }, page)
        new("UICorner", {CornerRadius = UDim.new(0, 9)}, row)
        new("UIStroke", {Color = Color3.fromRGB(54, 60, 74), Thickness = 1, Transparency = 0.72}, row)
        return row
    end
    local function rowLabel(row, text, w)
        return new("TextLabel", {
            Size = UDim2.new(w or 0.62, 0, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
            Text = text, TextColor3 = WHITE, Font = Enum.Font.GothamMedium, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        }, row)
    end

    local function addToggle(page, key, label)
        local row = makeRow(page, 42)
        rowLabel(row, label, 0.72)
        local pill = new("TextButton", {
            Size = UDim2.fromOffset(48, 23), Position = UDim2.new(1, -61, 0.5, -11), Text = "",
            AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(53, 58, 70), BorderSizePixel = 0,
        }, row)
        new("UICorner", {CornerRadius = UDim.new(1, 0)}, pill)
        local knob = new("Frame", {
            Size = UDim2.fromOffset(17, 17), Position = UDim2.fromOffset(3, 3),
            BackgroundColor3 = WHITE, BorderSizePixel = 0,
        }, pill)
        new("UICorner", {CornerRadius = UDim.new(1, 0)}, knob)
        local function render(animated)
            local on = S[key] == true
            if animated then
                tween(pill, 0.18, {BackgroundColor3 = on and ACC or Color3.fromRGB(53, 58, 70)})
                tween(knob, 0.18, {Position = on and UDim2.new(1, -20, 0, 3) or UDim2.fromOffset(3, 3)})
            else
                pill.BackgroundColor3 = on and ACC or Color3.fromRGB(53, 58, 70)
                knob.Position = on and UDim2.new(1, -20, 0, 3) or UDim2.fromOffset(3, 3)
            end
        end
        pill.MouseButton1Click:Connect(function()
            setSetting(key, not S[key]); render(true); saveSettings()
        end)
        render(false)
        table.insert(refreshers, function() render(false) end)
    end

    local function addSlider(page, key, label, mn, mx, step)
        local row = makeRow(page, 56)
        rowLabel(row, label, 0.68)
        local val = new("TextLabel", {
            Size = UDim2.new(0.25, -8, 0, 22), Position = UDim2.new(0.72, 0, 0, 1), BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.fromRGB(245, 112, 115),
            TextXAlignment = Enum.TextXAlignment.Right,
        }, row)
        local hit = new("TextButton", {
            Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(12, 29),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        }, row)
        local bar = new("Frame", {
            Size = UDim2.new(1, 0, 0, 5), Position = UDim2.new(0, 0, 0.5, -2),
            BackgroundColor3 = Color3.fromRGB(53, 58, 71), BorderSizePixel = 0,
        }, hit)
        new("UICorner", {CornerRadius = UDim.new(1, 0)}, bar)
        local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = ACC, BorderSizePixel = 0}, bar)
        new("UICorner", {CornerRadius = UDim.new(1, 0)}, fill)
        new("UIGradient", {Color = ColorSequence.new(ACC2, Color3.fromRGB(242, 87, 91))}, fill)
        local knob = new("Frame", {
            Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
            BackgroundColor3 = WHITE, BorderSizePixel = 0,
        }, bar)
        new("UICorner", {CornerRadius = UDim.new(1, 0)}, knob)
        new("UIStroke", {Color = ACC, Thickness = 1.5, Transparency = 0.05}, knob)
        local function render(animated)
            local a = clamp((S[key] - mn) / math.max(mx - mn, 0.0001), 0, 1)
            if animated then
                tween(fill, 0.08, {Size = UDim2.fromScale(a, 1)}, Enum.EasingStyle.Quad)
                tween(knob, 0.08, {Position = UDim2.fromScale(a, 0.5)}, Enum.EasingStyle.Quad)
            else
                fill.Size = UDim2.fromScale(a, 1); knob.Position = UDim2.fromScale(a, 0.5)
            end
            val.Text = step >= 1 and string.format("%d", math.floor(S[key] + 0.5)) or string.format("%.2f", S[key])
        end
        local dragging = false
        local function setFromX(x)
            local a = clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
            local v = mn + a * (mx - mn)
            v = clamp(math.floor(v / step + 0.5) * step, mn, mx)
            setSetting(key, v); render(true)
        end
        hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; page.ScrollingEnabled = false; setFromX(input.Position.X)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setFromX(input.Position.X) end
        end)
        UIS.InputEnded:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                dragging = false; page.ScrollingEnabled = true; saveSettings()
            end
        end)
        render(false)
        table.insert(refreshers, function() render(false) end)
    end


local function createRig(char)
    local hum = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local head = char:WaitForChild("Head", 5)
    if not (hum and hrp and head) then return nil end
    local isR15 = hum.RigType == Enum.HumanoidRigType.R15
    char:WaitForChild(isR15 and "RightFoot" or "Right Leg", 5)
    task.wait()

    local byName = {}
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("Motor6D") then byName[d.Name] = d end
    end
    local motors, c0 = {}, {}
    for logical, real in pairs(MOTOR_NAMES[isR15 and "R15" or "R6"]) do
        local m = byName[real]
        if m then
            motors[logical] = m
            c0[logical] = m.C0
        end
    end

    local legBase = 0
    if not isR15 then
        local leg = char:FindFirstChild("Left Leg")
        legBase = leg and leg.Size.Y or 2
    end
    local scale = hrp.Size.Y / 2

    local rig = {
        char = char, hum = hum, hrp = hrp, head = head, type = isR15 and "R15" or "R6",
        motors = motors, c0 = c0, posed = false,
        torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
        baseHip = hum.HipHeight, baseHRP = hrp.Size, legBase = legBase, scale = scale,
        standCenter = hum.HipHeight + hrp.Size.Y / 2 + legBase,
        crouchDrop = (isR15 and 1.2 or 0.8) * scale,
        crawlCenter = 0.72 * scale, crawlSizeY = 1.0 * scale,
        charHeight = 5 * scale,
        state = "HEALTHY", hpRatio = 1, holdArm = false, lostLimb = nil, feetBlood = 0, footSide = 1,
        dead = false,
        inj = {w = 0, limp = 0, hold = 0, flinch = 0, flinchDir = 1, stumbleT = -1, stumbleDir = 1, phase = 0, move = 0, breathe = 0},
        tm = {drip = 3, cough = 6, whimper = 8, foot = 0, stump = 0.4, stumble = 5},
    }
    Rigs[char] = rig
    return rig
end

local function newPose() return {rot = {}, off = {}} end
local function addRot(p, name, x, y, z)
    local r = p.rot[name]
    if r then p.rot[name] = r + Vector3.new(x, y, z) else p.rot[name] = Vector3.new(x, y, z) end
end
local function addOff(p, name, x, y, z)
    local r = p.off[name]
    if r then p.off[name] = r + Vector3.new(x, y, z) else p.off[name] = Vector3.new(x, y, z) end
end

local function jointDelta(c0, rotCF, off)
    local rc = c0.Rotation
    local inv = rc:Inverse()
    return CFrame.new(inv * off) * (inv * rotCF * rc)
end

local function applyPose(rig, pose)
    for name, motor in pairs(rig.motors) do
        if motor.Parent then
            local r, o = pose.rot[name], pose.off[name]
            if r or o then
                local rotCF = r and CFrame.Angles(r.X, r.Y, r.Z) or CFrame.identity
                motor.C0 = rig.c0[name] * jointDelta(rig.c0[name], rotCF, o or Vector3.zero)
            else
                motor.C0 = rig.c0[name]
            end
        end
    end
end

local function resetPose(rig)
    for name, motor in pairs(rig.motors) do
        if motor.Parent then motor.C0 = rig.c0[name] end
    end
end

local function setAnimate(rig, enabled)
    local anim = rig.char:FindFirstChild("Animate")
    if anim and (anim:IsA("LocalScript") or anim:IsA("Script")) then
        pcall(function() anim.Disabled = not enabled end)
    end
    if not enabled then
        local animator = rig.hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do tr:Stop(0.1) end
        end
    end
end

local BANDAGE_PARTS = {
    "Left Arm", "Right Arm", "Left Leg", "Right Leg", "Torso", "UpperTorso", "LowerTorso",
    "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
    "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
}

local function addBandage(char, partName)
    local part = char:FindFirstChild(partName)
    if not part or not part:IsA("BasePart") or part:FindFirstChild("Bandage") then return end
    local sz = part.Size
    local b = new("Part", {
        Name = "Bandage", Size = Vector3.new(sz.X + 0.08, math.max(0.3, sz.Y * 0.35), sz.Z + 0.08),
        Color = Color3.fromRGB(228, 218, 196), Material = Enum.Material.Fabric,
        CanCollide = false, CanQuery = false, CanTouch = false, Massless = true, CastShadow = false,
    })
    b.CFrame = part.CFrame * CFrame.new(0, rnd(-0.15, 0.15) * sz.Y, 0)
    new("WeldConstraint", {Part0 = part, Part1 = b}, b)
    b.Parent = part
end

local function syncBandages(rig, hp)
    local char = rig.char
    local target = 0
    if S.Bandages then
        if hp < 0.2 then target = 3 elseif hp < 0.4 then target = 2 elseif hp < 0.7 then target = 1 end
    end
    local existing, free = {}, {}
    for _, name in ipairs(BANDAGE_PARTS) do
        local part = char:FindFirstChild(name)
        if part then
            local b = part:FindFirstChild("Bandage")
            if b then table.insert(existing, b) else table.insert(free, name) end
        end
    end
    while #existing > target do
        local b = table.remove(existing)
        TS:Create(b, TweenInfo.new(0.5), {Transparency = 1}):Play()
        Debris:AddItem(b, 0.6)
    end
    local need = target - #existing
    for _ = 1, need do
        if #free == 0 then break end
        addBandage(char, table.remove(free, rng:NextInteger(1, #free)))
    end
end


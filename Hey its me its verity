local function triggerStumble(rig)
    if rig.inj.stumbleT >= 0 then return end
    rig.inj.stumbleT = 0
    rig.inj.stumbleDir = rng:NextNumber() < 0.5 and -1 or 1
    if rig == localRig then
        CamS.kick:kick(Vector3.new(-1.2, 0, rig.inj.stumbleDir * 2.5))
        CamS.shake = CamS.shake + 1.5
    end
end

local ST = {
    manual = 0, holdCrouch = false, forced = 0, target = 0, blend = 0, phase = 0, move = 0, drag = 0,
    clearance = 99, probeT = 0, animOff = false, base = nil, lastMult = 1, lastSet = nil,
    jumpOk = true, heightActive = false, uncrouchLock = 0,
}

local probeParams = RaycastParams.new()
probeParams.FilterType = Enum.RaycastFilterType.Exclude
probeParams.RespectCanCollide = true

local function probeClearance(rig)
    local filter = {rig.char, BloodFolder}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then table.insert(filter, p.Character) end
    end
    probeParams.FilterDescendantsInstances = filter
    local hrp = rig.hrp
    local root = hrp.Position
    local floorRes = workspace:Raycast(root, Vector3.new(0, -8 * rig.scale, 0), probeParams)
    local floorY = floorRes and floorRes.Position.Y or (root.Y - rig.standCenter)
    local H = rig.charHeight
    local up = Vector3.new(0, H * 1.15, 0)
    local look, right = hrp.CFrame.LookVector, hrp.CFrame.RightVector
    local vel = hrp.AssemblyLinearVelocity
    local hv = Vector3.new(vel.X, 0, vel.Z)
    local pts = {Vector3.zero, right * 0.7, -right * 0.7, look * 0.7, -look * 0.7}
    if hv.Magnitude > 1 then
        table.insert(pts, hv.Unit * 2.4)
        table.insert(pts, hv.Unit * 1.4)
    end
    local best = H * 1.15
    local base = Vector3.new(root.X, floorY + 0.3, root.Z)
    for _, off in ipairs(pts) do
        local r = workspace:Raycast(base + Vector3.new(off.X, 0, off.Z), up, probeParams)
        if r then
            local c = r.Position.Y - floorY
            if c < best then best = c end
        end
    end
    return best
end

local function stanceUpdate(rig, dt)
    local hum = rig.hum
    local dragTarget = 0
    if not S.Stance or hum.Health <= 0 then
        ST.target = 0
    else
        ST.probeT = ST.probeT - dt
        if ST.probeT <= 0 then
            ST.probeT = 0.07
            ST.clearance = S.AutoStance and probeClearance(rig) or 99
        end
        local r = ST.clearance / rig.charHeight
        local f
        if r >= 0.95 then f = 0
        elseif r >= 0.60 then f = (0.95 - r) / 0.35
        elseif r >= 0.34 then f = 1 + (0.60 - r) / 0.26
        else f = 2 end
        ST.forced = clamp(f, 0, 2)
        local manual = ST.holdCrouch and 0.7 or 0
        if ST.manual == 1 then manual = 0.7 elseif ST.manual == 2 then manual = 2 end
        local wound = 0
        if S.WoundedCrawl and rig.hpRatio <= 0.10 then
            wound = 2
            dragTarget = 1
        end
        ST.target = math.max(manual, ST.forced, wound)
    end
    local rate = ST.target > ST.blend and 7 or 5
    ST.blend = damp(ST.blend, ST.target, rate, dt)
    if math.abs(ST.blend - ST.target) < 0.004 then ST.blend = ST.target end
    ST.drag = damp(ST.drag, dragTarget, 3, dt)

    local v = rig.hrp.AssemblyLinearVelocity
    local sp = Vector3.new(v.X, 0, v.Z).Magnitude
    if sp < 0.6 then sp = 0 end
    ST.move = damp(ST.move, clamp(sp / math.max(hum.WalkSpeed, 1), 0, 1), 10, dt)
    local k = lerp(0.85, 1.3, clamp(ST.blend - 1, 0, 1))
    ST.phase = ST.phase + dt * sp * k
end

local function stanceBody(rig, dt)
    local hum, hrp = rig.hum, rig.hrp
    local b = ST.blend
    local needOff = b > 0.02
    if needOff ~= ST.animOff then
        ST.animOff = needOff
        setAnimate(rig, not needOff)
    end
    if needOff then
        for _, m in pairs(rig.motors) do
            if m.Parent then m.Transform = CFrame.identity end
        end
    end

    if b > 0.001 then
        local center
        if b <= 1 then
            center = rig.standCenter - rig.crouchDrop * b
        else
            center = lerp(rig.standCenter - rig.crouchDrop, rig.crawlCenter, b - 1)
        end
        local sizeY = rig.baseHRP.Y
        if S.ShrinkCollision then sizeY = lerp(rig.baseHRP.Y, rig.crawlSizeY, clamp(b - 1, 0, 1)) end
        local hip = center - sizeY / 2 - rig.legBase
        pcall(function() hum.HipHeight = hip end)
        hrp.Size = Vector3.new(rig.baseHRP.X, sizeY, rig.baseHRP.Z)
        ST.heightActive = true
    elseif ST.heightActive then
        ST.heightActive = false
        hum.HipHeight = rig.baseHip
        hrp.Size = rig.baseHRP
    end

    local mult
    if b <= 1 then mult = lerp(1, S.CrouchSpeed, b) else mult = lerp(S.CrouchSpeed, S.CrawlSpeed, b - 1) end
    if S.InjuryAnimations then
        mult = mult * (1 - 0.25 * rig.inj.limp)
        if rig.inj.stumbleT >= 0 then mult = mult * 0.6 end
    end
    if ST.lastSet == nil or math.abs(hum.WalkSpeed - ST.lastSet) > 0.05 then
        ST.base = hum.WalkSpeed / math.max(ST.lastMult, 0.05)
    end
    ST.lastMult = mult
    ST.lastSet = ST.base * mult
    hum.WalkSpeed = ST.lastSet

    local jumpOk = b < 0.6
    if jumpOk ~= ST.jumpOk then
        ST.jumpOk = jumpOk
        pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, jumpOk) end)
    end
end

local function stancePose(rig, pose, dt)
    local b = ST.blend
    if b < 0.01 then return end
    local wc = clamp(b <= 1 and b or 2 - b, 0, 1)
    local wk = clamp(b - 1, 0, 1)
    local m = ST.move
    local s, c = math.sin(ST.phase), math.cos(ST.phase)
    local R15 = rig.type == "R15"
    local drag = ST.drag
    local t = os.clock()

    if wc > 0 then
        local breath = math.sin(t * 1.8) * 0.02 * wc
        if R15 then
            local swing = 0.4 * m * (1 - 0.4 * wc)
            local hip = 1.45 * wc
            local hipL, hipR = hip + swing * s, hip - swing * s
            local kL = -2.3 * wc - 0.5 * m * math.max(0, s) * wc
            local kR = -2.3 * wc - 0.5 * m * math.max(0, -s) * wc
            addRot(pose, "LHip", hipL, 0, -0.14 * wc)
            addRot(pose, "RHip", hipR, 0, 0.14 * wc)
            addRot(pose, "LKnee", kL, 0, 0)
            addRot(pose, "RKnee", kR, 0, 0)
            addRot(pose, "LAnkle", -(hipL + kL), 0, 0)
            addRot(pose, "RAnkle", -(hipR + kR), 0, 0)
            addRot(pose, "Waist", -0.45 * wc + breath, 0, 0)
            addRot(pose, "Neck", 0.35 * wc, 0, 0)
            addRot(pose, "LShoulder", (0.55 - 0.3 * m * s) * wc, 0, -0.12 * wc)
            addRot(pose, "RShoulder", (0.55 + 0.3 * m * s) * wc, 0, 0.12 * wc)
            addRot(pose, "LElbow", 0.7 * wc, 0, 0)
            addRot(pose, "RElbow", 0.7 * wc, 0, 0)
        else
            local A = 0.8 * wc
            local L = A * ((1 - m) + m * s)
            local lean = 0.55 * wc
            addRot(pose, "Root", -lean + breath, 0, 0)
            addRot(pose, "LHip", L + lean, 0, -0.08 * wc)
            addRot(pose, "RHip", -L + lean, 0, 0.08 * wc)
            addRot(pose, "Neck", lean * 0.8, 0, 0)
            addRot(pose, "LShoulder", (0.5 - 0.3 * m * s) * wc, 0, -0.1 * wc)
            addRot(pose, "RShoulder", (0.5 + 0.3 * m * s) * wc, 0, 0.1 * wc)
            addOff(pose, "Root", 0, 0.32 * m * (1 - s * s) * wc, 0)
        end
    end

    if wk > 0 then
        local slow = 1 - 0.8 * drag
        local armAmp = 0.4 * (1 + 0.4 * drag)
        addRot(pose, "Root", -1.5 * wk, 0.05 * s * m * wk, 0.10 * s * m * wk * (1 + drag))
        addRot(pose, "Neck", (1.25 + 0.06 * c * m) * wk, 0, 0)
        addRot(pose, "LShoulder", (2.6 + armAmp * s * m) * wk, 0, -0.3 * wk)
        addRot(pose, "RShoulder", (2.6 - armAmp * s * m) * wk, 0, 0.3 * wk)
        if R15 then
            addRot(pose, "LElbow", (0.25 + 0.8 * m * math.max(0, -s)) * wk, 0, 0)
            addRot(pose, "RElbow", (0.25 + 0.8 * m * math.max(0, s)) * wk, 0, 0)
            addRot(pose, "LHip", (-0.12 + 0.3 * m * s * slow) * wk, 0, (-0.18 - 0.2 * drag) * wk)
            addRot(pose, "RHip", (-0.12 - 0.3 * m * s * slow) * wk, 0, (0.18 + 0.2 * drag) * wk)
            addRot(pose, "LKnee", -(0.18 + 0.75 * m * math.max(0, s) * slow) * wk, 0, 0)
            addRot(pose, "RKnee", -(0.18 + 0.75 * m * math.max(0, -s) * slow) * wk, 0, 0)
            addRot(pose, "Waist", 0, 0, -0.16 * s * m * wk * (1 + drag))
        else
            addRot(pose, "LHip", 0.28 * m * s * slow * wk, 0, -0.12 * wk)
            addRot(pose, "RHip", -0.28 * m * s * slow * wk, 0, 0.12 * wk)
        end
    end
end

local WOUND_PARTS = {"Left Arm", "Right Arm", "Torso", "Left Leg", "Right Leg", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperLeg"}

local function rigTimers(rig, dt)
    if rig.dead then return end
    local st, tm, char, hrp = rig.state, rig.tm, rig.char, rig.hrp
    local v = hrp.AssemblyLinearVelocity
    local sp = Vector3.new(v.X, 0, v.Z).Magnitude

    if st ~= "HEALTHY" then
        tm.drip = tm.drip - dt
        if tm.drip <= 0 then
            tm.drip = rnd(2.5, 4.5)
            local part = char:FindFirstChild(pick(WOUND_PARTS))
            if part and part:IsA("BasePart") then
                Blood.spray(part.Position, Vector3.new(0, -1, 0), 2, 2, 6, 0.3, 4, char)
                if rng:NextNumber() < 0.3 then
                    Audio.at(part.Position, dripSounds, 0.25, 1, 1.2, 40)
                end
            end
            rig.feetBlood = math.max(rig.feetBlood, 0.5)
        end
    end

    if st == "AGONIZING" or st == "DYING" then
        tm.cough = tm.cough - dt
        if tm.cough <= 0 then
            tm.cough = rnd(5, 9)
            local head = rig.head
            if S.Voices then Audio.at(head.Position, gurglingSounds, 0.5, 0.9, 1.1, 60) end
            Blood.spray(head.Position, head.CFrame.LookVector + Vector3.new(0, -0.4, 0), 6, 6, 14, 0.5, 6, char)
            Blood.mist(head.Position + head.CFrame.LookVector * 0.5, 0.4)
            if S.InjuryAnimations then triggerFlinch(rig, 0.1) end
        end
        tm.stumble = tm.stumble - dt
        if tm.stumble <= 0 then
            tm.stumble = rnd(3.5, 7)
            if sp > 3 and S.InjuryAnimations then triggerStumble(rig) end
        end
    end

    if st == "CRITICAL" or st == "AGONIZING" or st == "DYING" then
        tm.whimper = tm.whimper - dt
        if tm.whimper <= 0 then
            tm.whimper = rnd(6, 12)
            if S.Voices and rig.torso then
                Audio.at(rig.torso.Position, whimperSounds, 0.4 * S.WhimperVolume, 0.8, 1, 50)
            end
        end
    end

    if rig.stump and rig.stump.Parent then
        tm.stump = tm.stump - dt
        if tm.stump <= 0 then
            tm.stump = 0.4
            Blood.spray(rig.stump.Position, Vector3.new(rnd(-1, 1), -0.8, rnd(-1, 1)), 3, 4, 12, 0.5, 8, char)
        end
    end

    if rig.bleedUntil and os.clock() < rig.bleedUntil then
        tm.bleed = (tm.bleed or 0) - dt
        if tm.bleed <= 0 then
            tm.bleed = 0.45
            Blood.spray(hrp.Position, Vector3.new(0, -1, 0), 2, 3, 8, 0.4, 6, char)
            if S.BleedVapor and rng:NextNumber() < 0.35 then
                Blood.bleedVapor(hrp.Position)
            end
        end
        if rig.torso and not rig.torso:FindFirstChild("BleedLoop") then
            Blood.startBleedSound(rig.torso)
        end
        if rig.torso then
            local bl = rig.torso:FindFirstChild("BleedLoop")
            if bl then
                local lifeLeft = (rig.bleedUntil - os.clock()) / 7
                bl.PlaybackSpeed = clamp(0.65 + lifeLeft * 0.35, 0.55, 1)
            end
        end
    else
        if rig.torso then Blood.stopBleedSound(rig.torso) end
    end

    if S.Footprints and rig.feetBlood > 0.02 and sp > 2 then
        tm.foot = tm.foot - dt
        if tm.foot <= 0 then
            tm.foot = clamp(5.5 / sp, 0.22, 0.5)
            rig.footSide = -rig.footSide
            local cf = hrp.CFrame
            local pos = hrp.Position + cf.RightVector * 0.45 * rig.footSide
            Blood.footprint(pos, cf.LookVector, rig.feetBlood)
            rig.feetBlood = rig.feetBlood - 0.06
        end
    end
end

local function updateRig(rig, dt, isLocal)
    local hum = rig.hum
    if not hum.Parent or not rig.char.Parent then return end
    rig.hpRatio = hum.MaxHealth > 0 and clamp(hum.Health / hum.MaxHealth, 0, 1) or 1
    local dead = hum.Health <= 0
    if not dead then rigTimers(rig, dt) end

    if rig.override then
        applyPose(rig, rig.override(rig, dt))
        return
    end
    local inj = rig.inj
    local run = isLocal or rig.state ~= "HEALTHY" or rig.posed or inj.flinch > 0.004
    if not run or dead then return end
    local pose = newPose()
    if S.InjuryAnimations then injuryPose(rig, pose, dt) end
    if isLocal and S.Stance then stancePose(rig, pose, dt) end
    local active = (inj.w + inj.limp + inj.hold + inj.flinch + inj.breathe) > 0.006
        or inj.stumbleT >= 0 or (isLocal and ST.blend > 0.003)
    if active then
        applyPose(rig, pose)
        rig.posed = true
    elseif rig.posed then
        resetPose(rig)
        rig.posed = false
    end
end


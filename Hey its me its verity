local function new(class, props, parent)
    local o = Instance.new(class)
    if props then
        for k, v in pairs(props) do o[k] = v end
    end
    if parent then o.Parent = parent end
    return o
end

local function isVisuallySolid(inst)
    if not inst or not inst:IsA("BasePart") then return true end
    if inst.Transparency >= 0.98 then return false end
    if inst.LocalTransparencyModifier >= 0.98 then return false end
    if inst.CanQuery == false then return false end
    return true
end

local function raycastVisible(origin, direction, params, maxHits)
    maxHits = maxHits or 10
    local curOrigin = origin
    local curDir = direction
    local dirMag = curDir.Magnitude
    if dirMag < 0.001 then return nil end
    for _ = 1, maxHits do
        local hit = workspace:Raycast(curOrigin, curDir, params)
        if not hit then return nil end
        if isVisuallySolid(hit.Instance) then return hit end
        local step = curDir.Unit * 0.06
        local newOrigin = hit.Position + step
        local remainder = (curOrigin + curDir) - newOrigin
        if remainder.Magnitude < 0.05 then return nil end
        curOrigin = newOrigin
        curDir = remainder
    end
    return nil
end

local Spring = {}
Spring.__index = Spring
function Spring.new(k, d)
    return setmetatable({k = k, d = d, p = Vector3.zero, v = Vector3.zero}, Spring)
end
function Spring:step(dt)
    dt = math.min(dt, 1 / 30)
    local a = -self.p * self.k - self.v * self.d
    self.v = self.v + a * dt
    self.p = self.p + self.v * dt
    return self.p
end
function Spring:kick(v) self.v = self.v + v end

local function newNV(initial)
    local nv = Instance.new("NumberValue")
    nv.Value = initial or 0
    return nv
end
local function numTween(nv, goal, t, style, dir)
    local tw = TS:Create(nv, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), {Value = goal})
    tw:Play()
    return tw
end

local function surfaceCF(pos, normal, spin)
    local ref = math.abs(normal.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
    local right = ref:Cross(normal).Unit
    return CFrame.fromMatrix(pos, right, normal) * CFrame.Angles(0, spin or 0, 0)
end


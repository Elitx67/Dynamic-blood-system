function Blood.splat(pos, normal, size, vel, dmg)
    local group = {parts = {}}
    local function add(p)
        table.insert(group.parts, p)
        p.Parent = BloodFolder
    end

    local tangent = vel - normal * vel:Dot(normal)
    local tl = tangent.Magnitude
    local tdir = tl > 0.1 and tangent.Unit or nil
    local function disc(offset, d)
        local p = flatPart({
            Name = "BloodDisc", Shape = Enum.PartType.Cylinder,
            Size = Vector3.new(0.02 + rnd(0, 0.01), d, d * rnd(0.85, 1.15)),
            Color = WET_BLOOD, Reflectance = 0.14,
            CFrame = surfaceCF(pos + normal * (0.016 + rnd(0, 0.01)) + offset, normal, rnd(0, math.pi)) * CFrame.Angles(0, 0, math.pi / 2),
        })
        add(p)
        TS:Create(p, TweenInfo.new(30, Enum.EasingStyle.Quad), {Color = DRY_BLOOD, Reflectance = 0.02}):Play()
    end
    local main = size * 0.5 * rnd(0.8, 1.1)
    disc(Vector3.zero, main)
    if tdir then
        for k = 1, clamp(math.floor(tl / 12), 1, 4) do
            disc(tdir * (k * main * 0.55), main * (1 - k * 0.2))
        end
    end
    for _ = 1, rng:NextInteger(2, 4) do
        local rv = randDir()
        rv = rv - normal * rv:Dot(normal)
        if rv.Magnitude > 0.05 then
            rv = rv.Unit
            if tdir and rv:Dot(tdir) < 0 then rv = -rv end
            disc(rv * rnd(0.6, 1.6) * main, main * rnd(0.08, 0.25))
        end
    end

    registerGroup(group, S.BloodLifetime)

    if S.WallDrips and math.abs(normal.Y) < 0.35 and size > 2.4 and rng:NextNumber() < 0.6 then
        Blood.wallDrip(pos, normal, size)
    end
end

local recentPools = {}
local POOL_COOLDOWN = 2.0
local POOL_MIN_DIST = 4.0

function Blood.pool(pos, size, grow)
    local now = os.clock()
    for i = #recentPools, 1, -1 do
        if now - recentPools[i].t > POOL_COOLDOWN then
            table.remove(recentPools, i)
        end
    end
    for _, p in ipairs(recentPools) do
        if (p.pos - pos).Magnitude < POOL_MIN_DIST then
            return
        end
    end
    table.insert(recentPools, {pos = pos, t = now})
    if #recentPools > 24 then table.remove(recentPools, 1) end

    local res = raycastVisible(pos + Vector3.new(0, 1, 0), Vector3.new(0, -30, 0), baseRay)
    if not res then return end
    if res.Material == Enum.Material.Water then
        if S.WaterBlood then
            local att = new("Attachment", nil, workspace.Terrain)
            att.WorldPosition = res.Position + Vector3.new(0, 0.08, 0)
            new("ParticleEmitter", {
                Name = "WaterBloodCloud", Texture = MIST_TEX,
                Color = ColorSequence.new(WET_BLOOD),
                Size = NumberSequence.new({NumberSequenceKeypoint.new(0, size or 2), NumberSequenceKeypoint.new(1, (size or 2) * 2.2)}),
                Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1)}),
                Lifetime = NumberRange.new(2, 4), Speed = NumberRange.new(0.15, 0.8),
                SpreadAngle = Vector2.new(180, 180), Drag = 1.5, Rate = 0, LightEmission = 0,
            }, att):Emit(12)
            Debris:AddItem(att, 4.5)
        end
        return
    end
    size = (size or 3) * S.BloodPoolSize
    local group = {parts = {}}
    for i = 1, rng:NextInteger(2, 4) do
        local off = Vector3.zero
        if i > 1 then
            local rv = randDir()
            rv = Vector3.new(rv.X, 0, rv.Z)
            if rv.Magnitude < 0.05 then rv = Vector3.xAxis end
            off = rv.Unit * rnd(0.1, 0.35) * size
        end
        local final = size * (i == 1 and 1 or rnd(0.45, 0.8))
        local p = flatPart({
            Name = "BloodPool", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.025, 0.1, 0.1),
            Color = WET_BLOOD, Reflectance = 0.18,
            CFrame = surfaceCF(res.Position + res.Normal * (0.02 + 0.004 * i) + off, res.Normal, rnd(0, math.pi)) * CFrame.Angles(0, 0, math.pi / 2),
        })
        p.Parent = BloodFolder
        TS:Create(p, TweenInfo.new(grow or 12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = Vector3.new(0.025, final, final * rnd(0.85, 1.1)),
        }):Play()
        TS:Create(p, TweenInfo.new(45), {Color = DRY_BLOOD, Reflectance = 0.03}):Play()
        table.insert(group.parts, p)
    end
    registerGroup(group, S.BloodLifetime + 10)
    if #group.parts > 0 then
        local mainPool = group.parts[1]
        Blood.addPoolSkin(mainPool)
        Blood.attractInsects(mainPool)
        Blood.registerPoolForMerge(mainPool)
    end
    if S.FlyEffects then
        local att = new("Attachment", nil, workspace.Terrain)
        att.WorldPosition = res.Position + Vector3.new(0, 0.15, 0)
        new("ParticleEmitter", {
            Name = "BloodFlyMotes", Texture = MIST_TEX,
            Color = ColorSequence.new(Color3.fromRGB(24, 18, 16)),
            Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.035), NumberSequenceKeypoint.new(1, 0.015)}),
            Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1)}),
            Lifetime = NumberRange.new(0.8, 1.6), Speed = NumberRange.new(0.3, 1.1),
            SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, 0.3, 0),
            Rate = 3, RotSpeed = NumberRange.new(-90, 90), LightEmission = 0,
        }, att)
        Debris:AddItem(att, math.min(S.BloodLifetime, 25))
    end

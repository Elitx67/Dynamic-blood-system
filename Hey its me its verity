local DEATH_GORE = {
    Collapse = 1, Knockback = 1, Disintegrate = 1, Burn = 1,
    Headshot = 2, Decapitate = 2, Meat = 2, Dismember = 2, Bisect = 3, Explode = 3,
}
local DEATH_LIST = {"Random", "Collapse", "Knockback", "Headshot", "Decapitate", "Dismember", "Bisect", "Explode", "Meat", "Disintegrate", "Burn"}

local function applyDeath(rig)
    local char = rig.char
    local isLocal = rig == localRig
    rig.override = nil
    rig.dead = true
    rig.deadPoolDone = false
    setAnimate(rig, false)
    if S.DeathScream and rig.hrp then
        Audio.at(rig.hrp.Position, DEATH_SCREAM, 1.0, 0.92, 1.06, 90)
    end

    local style = S.DeathStyle
    if style == "Random" or not DeathFns[style] then
        local pool = {}
        for name, g in pairs(DEATH_GORE) do
            if g <= S.GoreLevel then table.insert(pool, name) end
        end
        if #pool == 0 then pool = {"Collapse"} end
        style = pick(pool)
    end
    rig.deathStyle = style

    local v = rig.hrp.AssemblyLinearVelocity
    local hv = Vector3.new(v.X, 0, v.Z)
    local dir = hv.Magnitude > 4 and hv.Unit or -rig.hrp.CFrame.LookVector
    local ctx = {dir = dir}

    Blood.bodyBlood(char, 100)
    if isLocal then
        CamS.deathSide = rng:NextNumber() < 0.5 and -1 or 1
        numTween(Post.fov, -15, 1.5)
        deathFlash.BackgroundTransparency = 0.2
        TS:Create(deathFlash, TweenInfo.new(1.2), {BackgroundTransparency = 1}):Play()
        FX.hit(0.35)
        FX.lensBlood(1.4)
        FX.crack(1.2)
        FX.addEdge(0.5)
        CamS.shake = CamS.shake + 15
        Post.muffleT.Value = 0.8
        numTween(Post.muffleT, 0.5, 3)
        deafen(1.0, 0, S.DeafnessDuration)
        task.delay(0.3, function() FX.deathFlashback() end)
        FX.eyeBlood(-1)
        task.delay(0.1, function() FX.eyeBlood(1) end)
        FX.chromAberration(1)
    end
    task.spawn(function()
        local ok, err = pcall(DeathFns[style], rig, ctx)
        if not ok then
            warn("[DynamicBlood] Error in death '" .. style .. "': " .. tostring(err))
        end
    end)
end

local RANK = {HEALTHY = 0, WOUNDED = 1, CRITICAL = 2, AGONIZING = 3, DYING = 4}

local function updateInjuryState(rig)
    if rig.dead then return end
    local hp = rig.hpRatio
    local old = rig.state
    local new = "HEALTHY"
    if hp <= 0.10 then new = "DYING"
    elseif hp <= 0.20 then new = "AGONIZING"
    elseif hp <= 0.40 then new = "CRITICAL"
    elseif hp <= 0.70 then new = "WOUNDED" end

    syncBandages(rig, hp)
    if new == old then return end
    rig.state = new
    if rig.hum.Health <= 0 then return end

    if RANK[new] > RANK[old] then
        if S.Footprints then rig.feetBlood = math.max(rig.feetBlood, 0.7) end
        if RANK[new] >= 2 then
            rig.holdArm = true
            startAura(rig)
            local arm = rig.char:FindFirstChild(limbName(rig, "LA"))
            if arm then stainCharacterPart(arm, 1) end
            if rig.torso then
                Audio.at(rig.torso.Position, whimperSounds, 0.7 * S.WhimperVolume, 0.9, 1.1)
                if S.Voices and new ~= "WOUNDED" then
                    Audio.at(rig.torso.Position, WOUNDED_GASP, S.GaspVolume, 0.92, 1.08, 70)
                end
            end
        end
        if RANK[new] >= 3 and not rig.lostLimb then
            loseArm(rig, rng:NextNumber() < 0.5 and "L" or "R")
        end
        if new == "DYING" and rig == localRig then
            FX.lensBlood(1)
            FX.hit(0.25)
        end
    else
        if hp > 0.40 then rig.holdArm = false end
        if hp > 0.70 then stopAura(rig) end
    end
end

local adrenalineCooldown = 0

local function onHealthChanged(rig, newHealth)
    local hum = rig.hum
    local old = rig.lastHealth or newHealth
    rig.lastHealth = newHealth
    local isLocal = rig == localRig
    rig.hpRatio = hum.MaxHealth > 0 and clamp(newHealth / hum.MaxHealth, 0, 1) or 1
    local char = rig.char

    if newHealth > old then
        if isLocal then
            FX.heal(clamp((newHealth - old) / hum.MaxHealth * 3, 0.15, 0.5))
            FX.edge = math.max(0, FX.edge - 0.4)
            Deaf.amount = math.max(0, Deaf.amount - 0.3)
        end
        if rig.hpRatio > 0.7 then rig.feetBlood = 0 end
    elseif newHealth < old then
        local dmg = old - newHealth
        local ratio = dmg / hum.MaxHealth
        local root = rig.hrp
        Blood.bodyBlood(char, dmg)
        if S.BloodHands then
            local leftHand = char:FindFirstChild(rig.type == "R15" and "LeftHand" or "Left Arm")
            local rightHand = char:FindFirstChild(rig.type == "R15" and "RightHand" or "Right Arm")
            if leftHand and rng:NextNumber() < 0.7 then stainCharacterPart(leftHand, clamp(ratio * 4, 0.3, 1)) end
            if rightHand and rng:NextNumber() < 0.7 then stainCharacterPart(rightHand, clamp(ratio * 4, 0.3, 1)) end
        end
        if S.InjuryAnimations then triggerFlinch(rig, ratio) end
        rig.feetBlood = math.max(rig.feetBlood, 0.4)
        local count = clamp(math.floor(dmg / 1.5), 2, 14)
        Blood.spray(root.Position, nil, count, 10, 30, 0.6, dmg, char)
        Blood.mist(root.Position, clamp(ratio * 4, 0.4, 1.5))
        if ratio > 0.1 then
            Blood.droplets(root.Position, randDir(), clamp(ratio * 5, 0.6, 2))
        end
        local lethal = newHealth <= 0
        if ratio > 0.15 and not lethal then
            Blood.pool(root.Position, clamp(ratio * 8, 1, 3), 8)
            rig.bleedUntil = os.clock() + 7
        end
        if ratio > 0.2 then Blood.wallSpatter(root.Position, 3) end
        if ratio > 0.15 and rig.torso and S.LungFoam then
            Blood.lungFoam(rig.torso.Position)
        end
        if ratio > 0.12 and S.WallSmear then
            local cam = workspace.CurrentCamera
            if cam then
                local lookDir = cam.CFrame.LookVector
                Blood.bodyPartSmear(root.Position + Vector3.new(rnd(-0.5,0.5), 0.5, rnd(-0.5,0.5)), lookDir)
            end
        end
        if S.RainBlood and isRaining() then
            local rainColor = Color3.fromRGB(
                clamp(math.floor(WET_BLOOD.R * 255 + 40), 0, 255),
                clamp(math.floor(WET_BLOOD.G * 255 + 10), 0, 255),
                clamp(math.floor(WET_BLOOD.B * 255 + 10), 0, 255)
            )
        end
        Audio.at(root.Position, fleshSounds, clamp(0.5 + ratio * 2, 0.5, 1.4), 0.85, 1.1)

        if isLocal then
            FX.hit(ratio)
            FX.addEdge(ratio * 1.5)
            FX.damageNumber(dmg, ratio > 0.15)
            camKick(ratio)
            if ratio > 0.1 then FX.lensBlood(clamp(ratio * 4, 0.5, 1.5)) end
            if ratio > 0.15 then FX.crack(clamp(ratio * 4, 0.5, 1.5)) end
            if ratio > 0.2 and rng:NextNumber() < S.TinnitusChance then FX.tinnitus() end
            if ratio > 0.1 then
                local side = rng:NextNumber() < 0.5 and -1 or 1
                deafen(clamp(ratio * 1.5, 0.15, 1) * S.DeafnessStrength, side, S.DeafnessDuration * clamp(ratio * 2, 0.5, 1.5))
            end
            if S.AdrenalineEnabled and rig.hpRatio < 0.15 and os.clock() > adrenalineCooldown then
                adrenalineCooldown = os.clock() + 3
                FX.adrenaline()
            end
            if ratio > 0.1 and rng:NextNumber() < 0.45 then
                FX.eyeBlood(rng:NextNumber() < 0.5 and -1 or 1)
            end
            if ratio > 0.25 then
                FX.doubleVision(3)
            end
            if ratio > 0.08 then
                FX.chromAberration(clamp(ratio * 3, 0.2, 1))
            end
            if ratio > 0.3 and rng:NextNumber() < 0.4 then
                FX_V11.eyeInjured = rng:NextNumber() < 0.5 and -1 or 1
                FX.diopticBlur(FX_V11.eyeInjured, clamp(ratio * 2, 0.3, 0.75))
            end
            if ratio > 0.2 then
                FX.activateLensDrops(rng:NextInteger(2, 5))
            end
            if ratio > 0.2 and S.DirectionalTinnitus and rig.torso then
                local hitPos = rig.hrp.Position + randDir() * 3
                local tinAtt = new("Attachment", nil, workspace.Terrain)
                tinAtt.WorldPosition = hitPos
                local tinS = new("Sound", {
                    SoundId = tinnitusSound,
                    Volume = clamp(ratio * 0.8, 0.2, 0.9) * S.SFXVolume,
                    RollOffMode = Enum.RollOffMode.Inverse,
                    RollOffMinDistance = 4,
                    RollOffMaxDistance = 30,
                }, tinAtt)
                tinS:Play()
                TS:Create(tinS, TweenInfo.new(2.5), {Volume = 0}):Play()
                Debris:AddItem(tinAtt, 4)
            end
        end
    end
    updateInjuryState(rig)
end

local RUN_ID = tostring(os.clock()) .. tostring(rng:NextInteger(1, 1e6))

local function onLocalSpawn(rig)
    local hum = rig.hum
    ST.manual, ST.blend, ST.target, ST.forced, ST.phase, ST.move, ST.drag = 0, 0, 0, 0, 0, 0, 0
    ST.animOff, ST.heightActive, ST.jumpOk = false, false, true
    ST.base, ST.lastMult, ST.lastSet = hum.WalkSpeed, 1, hum.WalkSpeed
    CamS.fpState, CamS.deathT, CamS.shake, CamS.prevStance, CamS.lastVy = nil, 0, 0, 0, 0
    pcall(function() hum.CameraOffset = Vector3.zero end)
    Deaf.amount = 0
    Deaf.timer = 0
    FX.reset()
end

local function registerCharacter(char)
    if char:GetAttribute("GoreRun") == RUN_ID then return end
    char:SetAttribute("GoreRun", RUN_ID)
    task.spawn(function()
        local rig = createRig(char)
        if not rig then return end
        rig.lastHealth = rig.hum.Health
        pcall(function() rig.hum.BreakJointsOnDeath = false end)
        if char == LocalPlayer.Character then
            localRig = rig
            onLocalSpawn(rig)
        end
        updateInjuryState(rig)
        rig.hum.HealthChanged:Connect(function(h) onHealthChanged(rig, h) end)
        rig.hum.Died:Connect(function() applyDeath(rig) end)
        rig.hum.StateChanged:Connect(function(_, state)
            if rig == localRig and state == Enum.HumanoidStateType.Landed then
                CamS.shake = CamS.shake + 1
            end
        end)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do

function Blood.chunk(kind, pos, dir, scale)
    if not S.Debris then return end
    if rng:NextNumber() > clamp(S.ChunkCount, 0, 1) then return end
    local def = ChunkDefs[kind]
    scale = scale or 1
    dir = dir or randDir()
    local p = new("Part", {
        Name = "Chunk_" .. kind, Shape = def.shape, Size = def.size * scale, Color = def.color,
        Material = Enum.Material.SmoothPlastic, CanCollide = true, CFrame = CFrame.new(pos) * CFrame.Angles(rnd(-3, 3), rnd(-3, 3), rnd(-3, 3)),
    })
    if def.trail then
        p.Material = Enum.Material.Slate
        local em = new("ParticleEmitter", {
            Color = ColorSequence.new(Color3.fromRGB(120, 4, 6)), Texture = DROP_TEX,
            Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.22), NumberSequenceKeypoint.new(1, 0.04)}),
            Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1)}),
            Lifetime = NumberRange.new(0.4, 0.8), Speed = NumberRange.new(0, 1), Rate = 28,
            Acceleration = Vector3.new(0, -30, 0), LockedToPart = false, LightEmission = 0,
        }, p)
        task.delay(2.2, function() if em.Parent then em.Enabled = false end end)
    end
    p.Parent = BloodFolder
    local cf = S.ChunkForce
    p.AssemblyLinearVelocity = dir.Unit * rnd(12, 30) * cf + Vector3.new(0, rnd(8, 20) * cf, 0)
    p.AssemblyAngularVelocity = Vector3.new(rnd(-25, 25), rnd(-25, 25), rnd(-25, 25))
    local hit = false
    local conn
    conn = p.Touched:Connect(function(o)
        if hit or o:IsDescendantOf(BloodFolder) then return end
        if o.Parent and o.Parent:FindFirstChildOfClass("Humanoid") then return end
        hit = true
        conn:Disconnect()
        Blood.spray(p.Position, Vector3.yAxis, 4, 4, 12, 0.9, 10)
        if def.snd then Audio.at(p.Position, def.snd, 0.5, 0.8, 1.2, 60) end
    end)
    Debris:AddItem(p, S.ChunkLifetime)
    return p
end

local BODY_PARTS = {
    "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "UpperTorso", "LowerTorso",
    "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm",
    "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg",
}
local STAIN_FACES = {
    Front  = {normal = Vector3.new(0, 0, -1), axis = "Z"},
    Back   = {normal = Vector3.new(0, 0, 1),  axis = "Z"},
    Left   = {normal = Vector3.new(-1, 0, 0), axis = "X"},
    Right  = {normal = Vector3.new(1, 0, 0),  axis = "X"},
    Top    = {normal = Vector3.new(0, 1, 0),  axis = "Y"},
    Bottom = {normal = Vector3.new(0, -1, 0), axis = "Y"},
}
local STAIN_KEYS = {"Front", "Back", "Left", "Right", "Top", "Bottom"}

stainCharacterPart = function(part, amount)
    if not S.BodyBlood or not part or not part:IsA("BasePart") then return end
    local n = 0
    for _, c in ipairs(part:GetChildren()) do
        if c.Name == "BloodStain" then n = n + 1 end
    end
    if n >= 4 then return end

    local key = STAIN_KEYS[rng:NextInteger(1, #STAIN_KEYS)]
    local fdef = STAIN_FACES[key]
    local normal = fdef.normal
    local sz = part.Size
    local faceSize
    if fdef.axis == "X" then faceSize = math.min(sz.Y, sz.Z)
    elseif fdef.axis == "Y" then faceSize = math.min(sz.X, sz.Z)
    else faceSize = math.min(sz.X, sz.Y) end
    local discSize = faceSize * rnd(0.35, 0.65)

    local halfSize = Vector3.new(sz.X, sz.Y, sz.Z) * 0.5
    local offset = Vector3.new(
        normal.X ~= 0 and normal.X * (halfSize.X + 0.006) or rnd(-halfSize.X * 0.5, halfSize.X * 0.5),
        normal.Y ~= 0 and normal.Y * (halfSize.Y + 0.006) or rnd(-halfSize.Y * 0.5, halfSize.Y * 0.5),
        normal.Z ~= 0 and normal.Z * (halfSize.Z + 0.006) or rnd(-halfSize.Z * 0.5, halfSize.Z * 0.5)
    )
    local worldCF = part.CFrame * CFrame.new(offset)
    local baseCF = surfaceCF(worldCF.Position, (part.CFrame - part.CFrame.Position) * normal, rnd(0, math.pi * 2))

    local p = new("Part", {
        Name = "BloodStain", Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(0.015, discSize, discSize * rnd(0.8, 1.2)),
        Color = WET_BLOOD, Material = Enum.Material.SmoothPlastic, Reflectance = 0.12,
        CanCollide = false, CanQuery = false, CanTouch = false, Massless = true, CastShadow = false,
        Transparency = clamp(0.55 - amount * 0.35, 0.1, 0.6),
        CFrame = baseCF * CFrame.Angles(0, 0, math.pi / 2),
    })
    new("WeldConstraint", {Part0 = part, Part1 = p}, p)
    p.Parent = part

    TS:Create(p, TweenInfo.new(25), {Color = DRY_BLOOD}):Play()
    task.delay(S.BloodLifetime, function()
        if p.Parent then
            TS:Create(p, TweenInfo.new(3), {Transparency = 1}):Play()
            Debris:AddItem(p, 3.1)
        end
    end)
end


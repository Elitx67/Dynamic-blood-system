local Deaf = {amount = 0, side = 0, timer = 0}

local function deafen(amount, side, duration)
    Deaf.amount = math.max(Deaf.amount, clamp(amount, 0, 1))
    if side and side ~= 0 then Deaf.side = side end
    Deaf.timer = math.max(Deaf.timer, duration or S.DeafnessDuration)
end

local function signOf(x) if x > 0 then return 1 elseif x < 0 then return -1 else return 0 end end

local function directionalVolume(worldPos, baseVol)
    local a = Deaf.amount
    if a < 0.01 then return baseVol end
    local cam = workspace.CurrentCamera
    if not cam then return baseVol * (1 - a * 0.7) end
    local toSound = worldPos - cam.CFrame.Position
    if toSound.Magnitude < 1 then return baseVol * (1 - a * 0.5) end
    toSound = toSound.Unit
    local sideDot = toSound:Dot(cam.CFrame.RightVector)
    local nearEar = 0.5
    if Deaf.side ~= 0 then
        nearEar = (sideDot * Deaf.side + 1) * 0.5
    end
    local atten = a * (0.4 + 0.6 * nearEar)
    return baseVol * (1 - atten)
end

RunService.Heartbeat:Connect(function(dt)
    if Deaf.timer > 0 then
        Deaf.timer = Deaf.timer - dt
        Deaf.amount = clamp(Deaf.amount - dt / math.max(S.DeafnessDuration, 0.5), 0, 1)
    else
        Deaf.amount = math.max(0, Deaf.amount - dt * 0.3)
    end
end)


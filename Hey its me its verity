local function updateBloodColors()
    local b = S.BloodBrightness or 1
    local wet = Color3.new(clamp(150 / 255 * b, 0, 1), clamp(6 / 255 * b, 0, 1), clamp(8 / 255 * b, 0, 1))
    local dry = Color3.new(clamp(58 / 255 * b, 0, 1), clamp(4 / 255 * b, 0, 1), clamp(4 / 255 * b, 0, 1))

function Blood.registerPoolForMerge(part)
    if not S.PoolMerge then return end
    table.insert(poolMergeList, {part = part, t = os.clock()})
    for i = #poolMergeList - 1, 1, -1 do
        local other = poolMergeList[i]
        if not other.part.Parent then
            table.remove(poolMergeList, i)
        elseif (other.part.Position - part.Position).Magnitude < 2 then
            local oldSz = other.part.Size
            local newSz = Vector3.new(oldSz.X, math.min(oldSz.Y * 1.35, 8), math.min(oldSz.Z * 1.35, 8))
            TS:Create(other.part, TweenInfo.new(2, Enum.EasingStyle.Quad), {Size = newSz}):Play()
            TS:Create(part, TweenInfo.new(1.5), {Transparency = 1}):Play()
            Debris:AddItem(part, 1.6)
            break
        end
    end
    if #poolMergeList > 60 then table.remove(poolMergeList, 1) end
end


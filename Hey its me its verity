local function makeVignette(color, z)
    local group = {frames = {}}
    local defs = {
        {UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 0), 90},
        {UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 0.62), -90},
        {UDim2.fromScale(0.3, 1), UDim2.fromScale(0, 0), 0},
        {UDim2.fromScale(0.3, 1), UDim2.fromScale(0.7, 0), 180},
    }
    for _, d in ipairs(defs) do
        local f = new("Frame", {
            Size = d[1], Position = d[2], BackgroundColor3 = color,
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = z,
        }, screenGui)
        new("UIGradient", {
            Rotation = d[3],
            Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)}),
        }, f)
        table.insert(group.frames, f)
    end
    function group.set(a)
        for _, f in ipairs(group.frames) do f.BackgroundTransparency = 1 - clamp(a, 0, 1) end
    end
    return group
end


local function limbName(rig, which)
    local R15 = rig.type == "R15"
    local map = {
        LA = R15 and "LeftUpperArm" or "Left Arm", RA = R15 and "RightUpperArm" or "Right Arm",
        LL = R15 and "LeftUpperLeg" or "Left Leg", RL = R15 and "RightUpperLeg" or "Right Leg",
        H = "Head",
    }
    return map[which]
end

local function ragdoll(rig, impulseDir, force, detach)
    local char = rig.char
    pcall(function() rig.hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    rig.override = nil
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Motor6D") and v.Part0 and v.Part1 then
            if not (detach and detach[v.Part1]) then
                local a0 = new("Attachment", {CFrame = v.C0}, v.Part0)
                local a1 = new("Attachment", {CFrame = v.C1}, v.Part1)
                new("BallSocketConstraint", {
                    Attachment0 = a0, Attachment1 = a1, LimitsEnabled = true,
                    UpperAngle = v.Name == "Neck" and 40 or 70,
                    TwistLimitsEnabled = true, TwistLowerAngle = -45, TwistUpperAngle = 45,
                }, v.Part0)
                new("NoCollisionConstraint", {Part0 = v.Part0, Part1 = v.Part1}, v.Part0)
            end
            v:Destroy()
        end
    end
    for _, p in ipairs(char:GetChildren()) do
        if p:IsA("BasePart") then
            p.CanCollide = p.Name ~= "HumanoidRootPart"
        end
    end
    if impulseDir then
        task.wait(0.04)
        local f = (force or 1) * S.RagdollForce
        for _, p in ipairs(char:GetChildren()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                p.AssemblyLinearVelocity = impulseDir.Unit * rnd(15, 35) * f + Vector3.new(0, rnd(8, 15) * f, 0)
            end
        end
    end
    if rig.torso then Audio.at(rig.torso.Position, boneBreakSounds, 1, 0.9, 1.1) end
end

local function convulse(rig)
    task.spawn(function()
        for _ = 1, 8 do
            task.wait(0.15)
            if not rig.char.Parent then break end
            for _, p in ipairs(rig.char:GetChildren()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.AssemblyAngularVelocity = Vector3.new(rnd(-20, 20), rnd(-20, 20), rnd(-20, 20))
                end
            end
        end
    end)
end

local function hideCharacter(char)
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Transparency = 1
            d.CanCollide = false
        elseif d:IsA("Decal") or d:IsA("Texture") then
            pcall(function() d.Transparency = 1 end)
        end
    end
end

local function severEffects(part, scale)
    local p = part.Position
    Blood.mist(p, 2.5 * scale)
    Blood.droplets(p, randDir(), 2 * scale)
    Blood.spray(p, nil, 22, 14, 40, 0.6, 25)
    Blood.chunk("bone", p, randDir(), 1)
    Audio.at(p, boneBreakSounds, 1.3, 0.85, 1.05)
    Audio.at(p, fleshSounds, 1, 0.75, 0.95)
end

local function collapsePose(rig, t)
    local pose = newPose()
    local e = t * t
    if rig.type == "R15" then
        addRot(pose, "LHip", 1.5 * e, 0, -0.2 * e)
        addRot(pose, "RHip", 1.3 * e, 0, 0.2 * e)
        addRot(pose, "LKnee", -2.4 * e, 0, 0)
        addRot(pose, "RKnee", -2.2 * e, 0, 0)
        addRot(pose, "Waist", -0.7 * e, 0, 0.2 * e)
        addRot(pose, "Neck", -0.5 * e, 0, 0.2 * e)
        addRot(pose, "LShoulder", 0.2 * e, 0, -0.4 * e)
        addRot(pose, "RShoulder", 0.2 * e, 0, 0.4 * e)
        addRot(pose, "LElbow", 0.3 * e, 0, 0)
        addOff(pose, "Root", 0, -1.1 * e, 0)
    else
        addRot(pose, "Root", -0.6 * e, 0, 0.15 * e)
        addRot(pose, "LHip", 0.9 * e + 0.5 * e, 0, -0.2 * e)
        addRot(pose, "RHip", 0.9 * e + 0.5 * e, 0, 0.2 * e)
        addRot(pose, "Neck", -0.5 * e, 0, 0)
        addRot(pose, "LShoulder", 0.2 * e, 0, -0.4 * e)
        addRot(pose, "RShoulder", 0.2 * e, 0, 0.4 * e)
        addOff(pose, "Root", 0, -0.7 * e, 0)
    end
    return pose
end

local DeathFns = {}

DeathFns.Collapse = function(rig, ctx)
    local t0 = os.clock()
    rig.override = function(r) return collapsePose(r, clamp((os.clock() - t0) / 0.8, 0, 1)) end
    Audio.at(rig.hrp.Position, whimperSounds, 0.8 * S.WhimperVolume, 0.7, 0.9)
    task.wait(0.8)
    ragdoll(rig, ctx.dir, 0.4)
    Blood.pool(rig.hrp.Position, 2.4, 16)
    Blood.spray(rig.hrp.Position, nil, 10, 6, 16, 0.6, 12, rig.char)
    convulse(rig)
end

DeathFns.Knockback = function(rig, ctx)
    ragdoll(rig, ctx.dir + Vector3.new(0, 0.5, 0), 1.9)
    local p = rig.torso and rig.torso.Position or rig.hrp.Position
    Blood.droplets(p, -ctx.dir, 2)
    Blood.spray(p, -ctx.dir + Vector3.yAxis * 0.3, 24, 14, 38, 0.5, 25, rig.char)
    Audio.impact(p, true)
    for _, part in ipairs(rig.char:GetChildren()) do
        if part:IsA("BasePart") then
            part.AssemblyAngularVelocity = Vector3.new(rnd(-12, 12), rnd(-8, 8), rnd(-12, 12))
        end
    end
    task.delay(0.9, function() if rig.torso and rig.torso.Parent and not rig.deadPoolDone then rig.deadPoolDone = true; Blood.pool(rig.torso.Position, 2.5, 14) end end)
end

DeathFns.Headshot = function(rig, ctx)
    local head = rig.head
    Blood.mist(head.Position, 4)
    Blood.droplets(head.Position, -ctx.dir + Vector3.yAxis * 0.3, 3)
    Blood.spray(head.Position, nil, 28, 14, 40, 0.7, 30)
    Audio.at(head.Position, fleshSounds, 1.4, 0.75, 0.95)
    for _ = 1, 2 do Blood.chunk("tooth", head.Position, randDir()) end
    head.Transparency = 1
    for _, v in ipairs(head:GetChildren()) do
        if v:IsA("Decal") or v:IsA("SpecialMesh") then v:Destroy() end
    end
    ragdoll(rig, ctx.dir, 0.5)
    Blood.arterial(rig.torso, 4.5, rig.char)
    Blood.wallSpatter(head.Position, 5)
    convulse(rig)
    task.delay(1.1, function() if rig.torso and rig.torso.Parent and not rig.deadPoolDone then rig.deadPoolDone = true; Blood.pool(rig.torso.Position, 3, 18) end end)
end

DeathFns.Decapitate = function(rig, ctx)
    local head = rig.head
    ragdoll(rig, ctx.dir, 0.6, {[head] = true})
    severEffects(head, 1)
    head.CanCollide = true
    head.AssemblyLinearVelocity = ctx.dir * 22 + Vector3.new(0, 26, 0)
    head.AssemblyAngularVelocity = Vector3.new(rnd(-15, 15), rnd(-15, 15), rnd(-15, 15))
    Blood.arterial(rig.torso, 5, rig.char)
    convulse(rig)
    task.delay(1.1, function() if rig.torso and rig.torso.Parent and not rig.deadPoolDone then rig.deadPoolDone = true; Blood.pool(rig.torso.Position, 3, 18) end end)
end

DeathFns.Dismember = function(rig, ctx)
    local all = {"LA", "RA", "LL", "RL"}
    local detach, parts = {}, {}
    for _ = 1, rng:NextInteger(2, 4) do
        if #all == 0 then break end
        local k = table.remove(all, rng:NextInteger(1, #all))
        local p = rig.char:FindFirstChild(limbName(rig, k))
        if p then
            detach[p] = true
            table.insert(parts, p)
        end
    end
    ragdoll(rig, ctx.dir, 0.7, detach)
    for _, p in ipairs(parts) do
        severEffects(p, 1)
        p.CanCollide = true
        p.AssemblyLinearVelocity = randDir() * 30 + Vector3.new(0, 20, 0)
        p.AssemblyAngularVelocity = Vector3.new(rnd(-15, 15), rnd(-15, 15), rnd(-15, 15))

function Blood.spray(origin, dir, count, vmin, vmax, spread, dmg, ignore)
    count = math.max(1, math.floor(count * OPT()))
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.RespectCanCollide = true
    rp.FilterDescendantsInstances = ignore and {BloodFolder, ignore} or {BloodFolder}
    for _ = 1, count do
        if #DropList >= 90 + 90 * S.Quality then break end
        local v
        if dir and dir.Magnitude > 0.01 then
            v = dir.Unit + Vector3.new(rnd(-1, 1), rnd(-1, 1), rnd(-1, 1)) * (spread or 0.5)
            v = v.Magnitude > 0.05 and v.Unit or dir.Unit
        else
            v = Vector3.new(rnd(-1, 1), rnd(0.2, 1.6), rnd(-1, 1)).Unit
        end
        local part = getDropPart()
        local sz = rnd(0.07, 0.16)
        part.Size = Vector3.new(sz, sz, sz * 2.4)
        part.CFrame = CFrame.lookAt(origin, origin + v)
        part.Parent = BloodFolder
        table.insert(DropList, {
            pos = origin, vel = v * rnd(vmin or 14, vmax or 38), part = part, age = 0, params = rp,
            size = rnd(1.4, 4.5) * (1 + (dmg or 0) / 70), dmg = dmg or 8,
        })
    end
end

local stainCharacterPart

local lastImpactSound = 0
RunService.Heartbeat:Connect(function(dt)
    dt = math.min(dt, 1 / 20)
    local g = Vector3.new(0, -workspace.Gravity * 0.55 * dt, 0)
    local i = #DropList
    while i >= 1 do
        local d = DropList[i]
        local remove = false
        d.vel = d.vel + g
        d.age = d.age + dt
        local step = d.vel * dt
        local res = raycastVisible(d.pos, step, d.params)
        if res then
            remove = true
            local inst = res.Instance
            local model = inst:FindFirstAncestorOfClass("Model")
            if model and model:FindFirstChildOfClass("Humanoid") then
                if stainCharacterPart then stainCharacterPart(inst, 1) end
            else
                Blood.splat(res.Position, res.Normal, d.size, d.vel, d.dmg)
                local now = os.clock()
                if now - lastImpactSound > 0.06 and rng:NextNumber() < 0.4 then
                    lastImpactSound = now
                    Audio.impact(res.Position, d.dmg > 20)
                end
            end
        elseif d.age > 4 then
            remove = true
        else
            d.pos = d.pos + step
            if d.vel.Magnitude > 0.1 then
                d.part.CFrame = CFrame.lookAt(d.pos, d.pos + d.vel)
            end
        end
        if remove then
            releaseDrop(d.part)
            DropList[i] = DropList[#DropList]
            DropList[#DropList] = nil
        end
        i = i - 1
    end
end)


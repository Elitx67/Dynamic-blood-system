local function camKick(ratio)
    local k = clamp(ratio * 6, 0.3, 2)
    CamS.kick:kick(Vector3.new(-0.5 * k * rnd(0.6, 1), rnd(-0.4, 0.4) * k, rnd(-1, 1) * 0.6 * k) * 3)
    CamS.shake = CamS.shake + clamp(ratio * 8, 0.5, 4)
end

local function injuryPose(rig, pose, dt)
    local inj = rig.inj
    local hp = rig.hpRatio
    local R15 = rig.type == "R15"
    local v = rig.hrp.AssemblyLinearVelocity
    local sp = Vector3.new(v.X, 0, v.Z).Magnitude
    inj.move = damp(inj.move, clamp(sp / 12, 0, 1), 8, dt)
    inj.phase = inj.phase + dt * sp * 0.55
    inj.w = damp(inj.w, clamp((0.7 - hp) / 0.7, 0, 1), 2.5, dt)
    inj.limp = damp(inj.limp, clamp((0.4 - hp) / 0.4, 0, 1), 2.5, dt)
    inj.breathe = damp(inj.breathe, clamp((0.3 - hp) / 0.3, 0, 1), 2.5, dt)
    inj.hold = damp(inj.hold, rig.holdArm and 1 or 0, 5, dt)
    inj.flinch = inj.flinch * math.exp(-8 * dt)
    if inj.stumbleT >= 0 then
        inj.stumbleT = inj.stumbleT + dt
        if inj.stumbleT > 0.8 then inj.stumbleT = -1 end
    end
    local t = os.clock()
    local w, limp, m, ph = inj.w, inj.limp, inj.move, inj.phase
    local lean = R15 and "Waist" or "Root"

    addRot(pose, lean, -0.2 * w, 0, 0)
    addRot(pose, "Neck", -0.15 * w + math.sin(t * 1.3) * 0.04 * w, 0, 0)

    if limp > 0.02 then
        addOff(pose, "Root", 0, -math.abs(math.sin(ph)) * 0.14 * limp * m, 0)
        addRot(pose, "Root", 0, 0, math.sin(ph) * 0.07 * limp * m)
        addRot(pose, "RHip", -0.25 * limp * m * (0.5 + 0.5 * math.sin(ph)), 0, 0)
    end

    if inj.hold > 0.01 then
        local side = rig.lostLimb == "L" and "R" or "L"
        local sgn = side == "L" and 1 or -1
        addRot(pose, side .. "Shoulder", (R15 and 0.7 or 1.0) * inj.hold, 0, 0.9 * sgn * inj.hold)
        if R15 then addRot(pose, side .. "Elbow", 1.5 * inj.hold, 0, 0) end
    end

    local f = inj.flinch
    if f > 0.01 then
        addRot(pose, lean, -0.45 * f, inj.flinchDir * 0.35 * f, 0)
        addRot(pose, "Neck", -0.3 * f, 0, 0)
        addRot(pose, "LShoulder", 0.5 * f, 0, -0.35 * f)
        addRot(pose, "RShoulder", 0.5 * f, 0, 0.35 * f)
    end

    if inj.stumbleT >= 0 then
        local e = math.sin(math.pi * inj.stumbleT / 0.8)
        local d = inj.stumbleDir
        addRot(pose, "Root", -0.12 * e, 0, 0.28 * e * d)
        addRot(pose, lean, -0.2 * e, 0.25 * e * d, 0)
        addRot(pose, "LShoulder", 0.4 * e, 0, -0.8 * e)
        addRot(pose, "RShoulder", 0.4 * e, 0, 0.8 * e)
        addOff(pose, "Root", 0, -0.2 * e, 0)
    end

    if inj.breathe > 0.02 then
        local b = math.sin(t * 4.5) * inj.breathe
        addRot(pose, lean, 0.035 * b, 0, 0)
        addRot(pose, "Neck", -0.03 * b, 0, 0)
    end
end

local function triggerFlinch(rig, ratio)
    rig.inj.flinch = clamp(rig.inj.flinch + ratio * 4, 0, 1)
    rig.inj.flinchDir = rng:NextNumber() < 0.5 and -1 or 1

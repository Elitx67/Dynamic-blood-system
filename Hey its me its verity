local function loseArm(rig, side)
    if rig.lostLimb or not S.LoseLimbs or S.GoreLevel < 2 then return end
    local char = rig.char
    local R15 = rig.type == "R15"
    local armName
    if R15 then
        armName = side == "L" and "LeftUpperArm" or "RightUpperArm"
    else
        armName = side == "L" and "Left Arm" or "Right Arm"
    end
    local arm = char:FindFirstChild(armName)
    local motor = rig.motors[side .. "Shoulder"]
    if not arm or not motor or not rig.torso then return end
    rig.lostLimb = side

    local set = {arm}
    if R15 then
        local lower = char:FindFirstChild(side == "L" and "LeftLowerArm" or "RightLowerArm")
        local hand = char:FindFirstChild(side == "L" and "LeftHand" or "RightHand")
        if lower then table.insert(set, lower) end
        if hand then table.insert(set, hand) end
    end
    local origin = arm.Position
    local vel = Vector3.new(rnd(-25, 25), rnd(15, 30), rnd(-25, 25))
    for _, p in ipairs(set) do
        local clone = p:Clone()
        for _, c in ipairs(clone:GetDescendants()) do
            if c:IsA("Motor6D") or c:IsA("Weld") or c:IsA("WeldConstraint") or c:IsA("Script") or c:IsA("LocalScript") then
                c:Destroy()
            end
        end
        clone.Anchored = false
        clone.CanCollide = true
        clone.CFrame = p.CFrame
        clone.Parent = BloodFolder
        clone.AssemblyLinearVelocity = vel
        clone.AssemblyAngularVelocity = Vector3.new(rnd(-20, 20), rnd(-20, 20), rnd(-20, 20))
        Debris:AddItem(clone, 20)
    end
    local stubCF = rig.torso.CFrame * rig.c0[side .. "Shoulder"]
    motor:Destroy()
    rig.motors[side .. "Shoulder"] = nil
    rig.motors[side .. "Elbow"] = nil
    for _, p in ipairs(set) do
        for _, c in ipairs(p:GetChildren()) do
            if c:IsA("Decal") or c:IsA("SpecialMesh") or c.Name == "Bandage" then c:Destroy() end
        end
        p.Anchored = true
        p.CanCollide = false
        p.Transparency = 1
    end
    local stub = new("Part", {
        Name = "BloodyStub", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9),
        Color = Color3.fromRGB(140, 20, 20), Material = Enum.Material.SmoothPlastic,
        CanCollide = false, Massless = true, CFrame = CFrame.new(stubCF.Position),
    })
    new("WeldConstraint", {Part0 = rig.torso, Part1 = stub}, stub)
    stub.Parent = char
    rig.stump = stub

    Blood.mist(origin, 3)
    Blood.droplets(origin, randDir(), 2)
    Blood.spray(origin, nil, 30, 14, 40, 0.6, 30, char)
    Blood.chunk("bone", origin, randDir(), 1)
    Audio.at(origin, fleshSounds, 1.4, 0.75, 0.95)
    Audio.at(origin, boneBreakSounds, 1.2, 0.85, 1.05)
    if rig == localRig then
        FX.lensBlood(1)
        deafen(0.6, rng:NextNumber() < 0.5 and -1 or 1, 3)
    end
    if rig.stump then
        Blood.stumpBleed(rig.stump, 15)
    end
end


    p.CharacterAdded:Connect(registerCharacter)
end
Players.PlayerAdded:Connect(function(p) p.CharacterAdded:Connect(registerCharacter) end)

local function tryRegister(inst)
    if inst:IsA("Humanoid") and inst.Parent and inst.Parent:IsA("Model") then
        registerCharacter(inst.Parent)
    end
end
workspace.DescendantAdded:Connect(tryRegister)
for _, d in ipairs(workspace:GetDescendants()) do tryRegister(d) end

workspace.ChildAdded:Connect(function(child)
    if child:IsA("Explosion") then
        if S.ExplosionBloodReaction then
            for _, player in ipairs(Players:GetPlayers()) do
                local character = player.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if root and humanoid and humanoid.Health > 0 then
                    local delta = root.Position - child.Position
                    local distance = delta.Magnitude
                    if distance > 0.1 and distance <= math.max(child.BlastRadius, 12) then
                        local intensity = clamp(1 - distance / math.max(child.BlastRadius, 12), 0.1, 1)
                        Blood.spray(root.Position, delta.Unit, math.floor(3 + intensity * 8), 6, 18, 0.45, intensity * 12, character)
                        Blood.pool(root.Position, intensity * 2.2, 3)
                    end
                end
            end
        end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local to = child.Position - cam.CFrame.Position
        local d = to.Magnitude
        if d < 60 then
            local intensity = clamp((60 - d) / 60, 0, 1)
            CamS.shake = CamS.shake + intensity * 6
            Post.muffleT.Value = math.max(Post.muffleT.Value, intensity * 0.8)
            numTween(Post.muffleT, 0, 2.5)
            local side = 0
            if d > 3 then
                side = signOf(to.Unit:Dot(cam.CFrame.RightVector))
            end
            deafen(intensity * S.DeafnessStrength, side, S.DeafnessDuration * clamp(intensity, 0.3, 1.5))
        end
    end
end)


    R6 = {
        Root = "RootJoint", Neck = "Neck", LShoulder = "Left Shoulder", RShoulder = "Right Shoulder",
        LHip = "Left Hip", RHip = "Right Hip",
    },
    R15 = {
        Root = "RootJoint", Waist = "Waist", Neck = "Neck", LShoulder = "LeftShoulder", RShoulder = "RightShoulder",
        LElbow = "LeftElbow", RElbow = "RightElbow", LHip = "LeftHip", RHip = "RightHip",
        LKnee = "LeftKnee", RKnee = "RightKnee", LAnkle = "LeftAnkle", RAnkle = "RightAnkle",
    },

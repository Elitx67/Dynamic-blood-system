local function thump(vol)
    local s = Audio.ui(HEARTBEAT_THUMP, vol, 0.3)
    if s then TS:Create(s, TweenInfo.new(0.4), {Volume = 0}):Play() end
end

function FX.update(dt, hp, dead)
    local low = dead and 0 or clamp((0.4 - hp) / 0.4, 0, 1)
    if low > 0 and S.ScreenFX then
        local bpm = 70 + low * 95
        FX.hbPhase = FX.hbPhase + dt * bpm / 60
        if FX.hbPhase >= 1 then
            FX.hbPhase = FX.hbPhase - 1
            FX.beat1, FX.beat2 = false, false
        end
        if not FX.beat1 then
            FX.beat1 = true
            FX.hbEnv = 1
            if S.HeartbeatSFX then thump((0.3 + low * 0.5) * S.HeartbeatVolume) end
        end
        if not FX.beat2 and FX.hbPhase >= 0.28 then
            FX.beat2 = true
            FX.hbEnv = 0.7
            if S.HeartbeatSFX then thump((0.2 + low * 0.4) * S.HeartbeatVolume) end
        end
    end
    FX.hbEnv = FX.hbEnv * math.exp(-8 * dt)

    local vig = S.VignetteIntensity
    if S.ScreenFX and S.Vignette then
        local deadA = dead and 0.55 or 0
        vigDark.set(clamp((low * (0.55 + 0.2 * FX.hbEnv) + FX.impulse.Value * 0.45 + deadA) * vig, 0, 1))
        vigBlood.set(clamp((FX.edge * 0.55 + low * (0.25 + 0.25 * FX.hbEnv) + FX.impulse.Value * 0.35) * vig, 0, 1))
    else
        vigDark.set(0)
        vigBlood.set(0)
    end
    Post.update(hp, dead)

    if S.ScreenFX and S.BreathingVignette and low > 0.1 then
        local pulse = FX.hbEnv * 0.04 * low
        local sc = 1 + pulse
        vigDark.set(clamp((low * (0.55 + 0.25 * FX.hbEnv) + FX.impulse.Value * 0.45 + (dead and 0.55 or 0)) * S.VignetteIntensity, 0, 1))
    end

    if S.ScreenFX and S.HypoxicTunnel then
        local tunnelT = clamp((0.20 - hp) / 0.20, 0, 1)
        if tunnelT > 0 then
            local borderAlpha = clamp(tunnelT * 0.9, 0, 1)
            tunnelBorder.BackgroundTransparency = 1 - borderAlpha * 0.85
            Post.dof.FarIntensity = math.max(Post.dof.FarIntensity, tunnelT * 0.6)
            Post.dof.NearIntensity = math.max(Post.dof.NearIntensity or 0, tunnelT * 0.3)
        else
            tunnelBorder.BackgroundTransparency = 1
        end
    end

    if S.ScreenFX and S.FilmGrain then
        local grainT = clamp((0.40 - hp) / 0.40, 0, 1)
        FX_V11.grainIntensity = grainT
    end

    if S.ScreenFX and S.ChromAberration and low > 0.15 then
        local continuousChrom = low * 0.12
        chromR.BackgroundTransparency = 1 - continuousChrom
        chromG.BackgroundTransparency = 1 - continuousChrom * 0.4
        chromB.BackgroundTransparency = 1 - continuousChrom
        local s = continuousChrom * 0.002
        chromR.Position = UDim2.fromScale(-s, -s * 0.5)
        chromB.Position = UDim2.fromScale(s, s * 0.5)
    elseif FX_V11.chromIntensity <= 0 then
        chromR.BackgroundTransparency = 1
        chromG.BackgroundTransparency = 1
        chromB.BackgroundTransparency = 1
    end
end

local Blood = {}
local DropList, DropPool = {}, {}
local SplatGroups = {}

local baseRay = RaycastParams.new()
baseRay.FilterType = Enum.RaycastFilterType.Exclude
baseRay.FilterDescendantsInstances = {BloodFolder}
baseRay.RespectCanCollide = true

local function flatPart(props)
    props.Anchored = true
    props.CanCollide = false
    props.CanQuery = false
    props.CanTouch = false
    props.CastShadow = false
    props.Material = props.Material or Enum.Material.SmoothPlastic
    return new("Part", props)
end

local function alignedCF(pos, normal, forward)
    local f = forward - normal * forward:Dot(normal)
    if f.Magnitude < 0.05 then return surfaceCF(pos, normal, rnd(0, math.pi * 2)) end
    f = f.Unit
    return CFrame.fromMatrix(pos, f:Cross(normal), normal)
end

local function getDropPart()
    local p = table.remove(DropPool)
    if p then return p end
    return flatPart({
        Name = "Drop", Color = WET_BLOOD, Reflectance = 0.25, Size = Vector3.new(0.1, 0.1, 0.25),
    })
end

local function releaseDrop(p)

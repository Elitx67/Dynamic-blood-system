local Audio = {}

function Audio.at(pos, ids, vol, p1, p2, range)
    if typeof(ids) == "table" then ids = pick(ids) end
    if not ids then return end
    local att = new("Attachment", nil, workspace.Terrain)
    att.WorldPosition = pos
    local baseVol = clamp((vol or 1) * S.SFXVolume, 0, 4)
    local s = new("Sound", {
        SoundId = ids,
        Volume = directionalVolume(pos, baseVol),
        PlaybackSpeed = rnd(p1 or 0.9, p2 or 1.1),
        RollOffMinDistance = 8,
        RollOffMaxDistance = range or 110,
        RollOffMode = Enum.RollOffMode.InverseTapered,
    }, att)
    local up = workspace:Raycast(pos, Vector3.new(0, 30, 0))
    if up then
        new("ReverbSoundEffect", {DecayTime = 1.4, Density = 0.8, Diffusion = 0.8, DryLevel = 0, WetLevel = -9}, s)
    end
    s:Play()
    Debris:AddItem(att, 6)
    return s
end

function Audio.ui(ids, vol, speed)
    if typeof(ids) == "table" then ids = pick(ids) end
    if not ids then return end
    local s = new("Sound", {SoundId = ids, Volume = clamp((vol or 1) * S.SFXVolume, 0, 4), PlaybackSpeed = speed or 1}, SoundService)
    s:Play()
    Debris:AddItem(s, 6)
    return s
end

function Audio.impact(pos, heavy)
    Audio.at(pos, splatSounds, heavy and 0.8 or 0.45, 0.85, 1.15)

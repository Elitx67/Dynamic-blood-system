local HEAD_ATTACH = {HatAttachment = true, HairAttachment = true, FaceFrontAttachment = true, FaceCenterAttachment = true}

local function setFirstPerson(rig, fp)
    if CamS.fpState == fp then return end
    CamS.fpState = fp
    local hide = fp and S.HideHeadFP
    rig.head.LocalTransparencyModifier = hide and 1 or 0
    for _, d in ipairs(rig.char:GetChildren()) do
        if d:IsA("Accessory") then
            local h = d:FindFirstChild("Handle")
            local att = h and h:FindFirstChildOfClass("Attachment")
            if h and att and HEAD_ATTACH[att.Name] then
                h.LocalTransparencyModifier = hide and 1 or 0
            end
        end
    end
end

local function camUpdate(dt)
    local cam = workspace.CurrentCamera
    local rig = localRig
    if not cam or not rig or not rig.hum.Parent or not rig.head.Parent then return end
    local hum, hrp, head = rig.hum, rig.hrp, rig.head
    local dead = hum.Health <= 0

    local camCF = cam.CFrame
    local firstPerson = (camCF.Position - head.Position).Magnitude < 1.5
    setFirstPerson(rig, firstPerson)
    if not S.CameraEffects then return end

    local vel = hrp.AssemblyLinearVelocity
    local hv = Vector3.new(vel.X, 0, vel.Z)
    local speed = hv.Magnitude
    CamS.smoothSpeed = damp(CamS.smoothSpeed, speed, 8, dt)
    local sp = CamS.smoothSpeed
    local maxSp = math.max(hum.WalkSpeed, 1)
    local moveAmt = clamp(sp / maxSp, 0, 1.4)
    local grounded = hum.FloorMaterial ~= Enum.Material.Air
    local hp = rig.hpRatio
    local low = dead and 0 or clamp((0.4 - hp) / 0.4, 0, 1)
    local b = ST.blend
    local t = os.clock()

    if b > 1.2 then
        CamS.bobT = ST.phase
    else
        CamS.bobT = CamS.bobT + dt * sp * 0.55
    end
    local ph = CamS.bobT
    local bobAmt = S.HeadBob * moveAmt * (grounded and 1 or 0.1) * (1 - 0.35 * math.min(b, 1))
    if dead then bobAmt = 0 end

    local px, py, pz = 0, 0, 0
    local roll, pitch, yaw = 0, 0, 0

    if b > 1.2 then
        px = math.sin(ph) * 0.14 * moveAmt * S.HeadBob
        py = (math.abs(math.cos(ph)) * 0.05 - 0.02) * moveAmt * S.HeadBob
        roll = roll + math.sin(ph) * 0.03 * moveAmt * S.HeadBob
    else
        px = math.sin(ph) * 0.06 * bobAmt
        py = (math.abs(math.cos(ph)) * 0.07 - 0.035) * bobAmt
        roll = roll + math.sin(ph) * 0.012 * bobAmt
    end

    if S.InjuryAnimations then
        px = px + math.sin(t * 3.5) * 0.05 * rig.inj.limp * moveAmt
        py = py + math.sin(t * 5.5) * 0.02 * rig.inj.breathe
        roll = roll + math.sin(t * 0.8) * 0.02 * low * S.CameraRoll
        pitch = pitch + math.sin(t * 1.1) * 0.012 * low
    end

    local sx = hv:Dot(camCF.RightVector)
    CamS.strafe = damp(CamS.strafe, clamp(sx / maxSp, -1, 1), 8, dt)
    roll = roll - CamS.strafe * 0.035 * S.CameraRoll

    CamS.land:step(dt)
    py = py + CamS.land.p.Y
    if grounded and CamS.lastVy < -22 and vel.Y > -2 then
        local lsh = S.LandingShake
        CamS.land:kick(Vector3.new(0, -clamp(-CamS.lastVy, 0, 60) * 0.2 * lsh, 0))
        CamS.shake = CamS.shake + clamp(-CamS.lastVy / 12, 0, 4) * lsh
    end
    CamS.lastVy = vel.Y

    local stanceInt = math.floor(b + 0.5)
    if stanceInt ~= CamS.prevStance then
        CamS.prevStance = stanceInt
        CamS.land:kick(Vector3.new(0, stanceInt > 0 and -2.2 or 1.2, 0))
    end

    local kick = CamS.kick:step(dt)
    pitch, yaw, roll = pitch + kick.X * 0.02, yaw + kick.Y * 0.02, roll + kick.Z * 0.02 * S.CameraRoll
    CamS.noiseT = CamS.noiseT + dt * 22
    local pw = clamp(CamS.shake, 0, 14) * S.CameraShake * 0.0035
    local ambient = 0.0006 * S.CameraNoise
    pitch = pitch + math.noise(CamS.noiseT, 0, 0) * (pw * 2 + ambient)
    yaw = yaw + math.noise(CamS.noiseT + 100, 0, 0) * (pw * 2 + ambient)
    roll = roll + math.noise(CamS.noiseT + 200, 0, 0) * (pw * 2 + ambient)
    CamS.shake = math.max(CamS.shake - 8 * dt, 0)

    if dead and S.DeathCamera then
        CamS.deathT = math.min(1, CamS.deathT + dt / 2.2)
        local e = CamS.deathT * CamS.deathT * (3 - 2 * CamS.deathT)
        roll = roll + CamS.deathSide * 0.5 * e
        pitch = pitch - 0.12 * e
        py = py - 1.3 * e
    elseif not dead then
        CamS.deathT = 0
    end

    local fpScale = firstPerson and 1 or 0
    cam.CFrame = camCF
        * CFrame.new(px * fpScale, py * (firstPerson and 1 or 0.4), 0)
        * CFrame.Angles(pitch, yaw, roll * (firstPerson and 1 or 0.5))

    if S.DynamicFOV then
        local target = S.BaseFOV + sp * 0.18 + Post.fov.Value
        target = target - 3 * math.min(b, 1) - 3 * clamp(b - 1, 0, 1) + FX.hbEnv * 2.2 * low
        if dead then target = target - 10 * CamS.deathT end
        CamS.fovCur = damp(cam.FieldOfView, target, 8, dt)
        cam.FieldOfView = CamS.fovCur
    end
end


function Post.update(hp, dead)
    local low = dead and 0 or clamp((0.4 - hp) / 0.4, 0, 1)
    if not S.ScreenFX then low = 0 end
    local useCC = S.ScreenFX and S.ColorGrading
    Post.cc.Saturation = useCC and clamp(-(low * 0.6) - Post.sat.Value, -1, 1) or 0
    Post.cc.Contrast = useCC and clamp(low * 0.12, -1, 1) or 0
    Post.cc.Brightness = useCC and clamp(-low * 0.04, -1, 1) or 0
    local tint = useCC and clamp(low * 0.22 + Post.tint.Value * 0.4, 0, 0.9) or 0
    Post.cc.TintColor = Color3.new(1, clamp(1 - tint, 0, 1), clamp(1 - tint * 1.1, 0, 1))
    Post.blur.Size = (S.ScreenFX and S.BlurFX) and math.max(Post.blurT.Value, low * 3) or 0
    Post.bloom.Intensity = S.ScreenFX and Post.bloomT.Value or 0
    local dofOn = S.ScreenFX and S.DepthOfField
    Post.dof.FarIntensity = dofOn and low * 0.45 or 0
    Post.dof.FocusDistance = 18
    local m = S.Muffle and (low * 1 + Post.muffleT.Value + Deaf.amount) or Deaf.amount
    muffle.HighGain = -clamp(m, 0, 1) * 32
    muffle.MidGain = -clamp(m, 0, 1) * 7
    muffle.LowGain = -clamp(m, 0, 1) * 3
end

